{
  "name": "novel-company",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NovelCompany local-first desktop application",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "package": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.novelcompany.app",
    "productName": "NovelCompany",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest",
    "wait-on": "latest"
  }
}
